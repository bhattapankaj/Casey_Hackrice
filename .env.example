# Server-only ElevenLabs configuration. Never use a NEXT_PUBLIC_ prefix.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
GEMINI_API_KEY=
# Optional model override. Casey defaults to the current low-latency Flash model.
GEMINI_MODEL=gemini-3.8-flash

# Server-only Tiger Data configuration. The demo works when this is unset.
TIGER_DATABASE_URL=
TIGER_DATABASE_POOL_MAX=3
